<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>planeopt — {{ r.mission }} / {{ r.aircraft }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 62rem; padding: 0 1rem; }
  h1 { font-size: 1.4rem; } h2 { font-size: 1.1rem; margin-top: 2rem; }
  table { border-collapse: collapse; margin: .5rem 0; }
  td, th { border: 1px solid color-mix(in srgb, currentColor 25%, transparent); padding: .3rem .7rem; text-align: left; }
  .status { padding: .6rem 1rem; border-radius: .5rem; background: color-mix(in srgb, orange 18%, transparent); }
  .trust-failure { padding: .8rem 1rem; border: 2px solid #c33; border-radius: .5rem;
    background: color-mix(in srgb, red 12%, transparent); font-weight: 650; }
  .meta { opacity: .7; font-size: .85rem; }
  .ok { color: #2c8a2c; font-weight: 600; } .bad { color: #c33; font-weight: 600; }
  /* an ACTIVE BOUND is not a failure — it is the design asking for something it
     is not allowed to have. Amber, not the red `.bad` uses, because seven red
     rows in the design-variable table would read as seven errors. */
  .pinned { color: #a06a00; font-weight: 600; }
  img { max-width: 100%; }
  .grid { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  /* Wide tables (the parts list is 8 columns) scroll INSIDE their own box.
     Without this they push the 62rem body wider than the viewport and every
     other section on the page inherits the horizontal scroll. */
  .scroll { overflow-x: auto; }
  table.parts { font-size: .85rem; }
  table.parts td { vertical-align: top; }
  table.parts td:nth-child(7), table.parts td:nth-child(8) { min-width: 16rem; }
  /* Numbers line up as numbers: right-aligned, tabular figures, so a column of
     stations can be scanned rather than read. */
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  /* An UNCHECKED requirement is a caveat, not an error. Amber and normal
     weight, for the same reason `.pinned` exists: twenty bold red cells would
     read as twenty failures when they are the builder's ordinary to-do list. */
  .caveat { color: #a06a00; }
</style>
</head>
<body>
<h1>planeopt run — {{ r.mission }} / {{ r.aircraft }}</h1>
<p class="meta">objective: <b>{{ r.objective }}</b>
({{ r.performance.get("objective_units", r.diagnostics.get("objective_units","")) }},
wind mode: {{ r.diagnostics.get("wind_mode","") }}) · created {{ r.created }}</p>
<p class="status">{{ r.status }}</p>
{% if r.diagnostics.get("design_trustworthy") is sameas false %}
<p class="trust-failure">DESIGN NOT TRUSTWORTHY FOR FLIGHT OR CONSTRUCTION.
{% for reason in r.diagnostics.get("design_trust_failures") or [] %}
{% if not loop.first %}; {% endif %}{{ reason }}{% endfor %}.
The values below remain diagnostic results, not an airworthy design recommendation.</p>
{% endif %}
{% if has_3d %}<p><a href="interactive_3d.html">interactive 3D model &#8599;</a> (rotate/zoom in browser)</p>{% endif %}

{% if r.performance.get("best") %}
{% set best = r.performance["best"] %}
<h2>Best operating point</h2>
<table>
<tr><th>{{ r.objective }}</th><td><b>{{ "%.1f"|format(best.get("objective_value", 0)) }} {{ r.performance.get("objective_units","") }}</b></td></tr>
<tr><th>V</th><td>{{ "%.1f"|format(best["V_ms"]) }} m/s</td></tr>
<tr><th>P_elec</th><td>{{ "%.1f"|format(best["P_elec_w"]) }} W ({{ "%.1f"|format(r.performance["watts_per_kg"]) }} W/kg)</td></tr>
<tr><th>L/D (trimmed)</th><td>{{ "%.1f"|format(best["L_over_D"]) }}</td></tr>
<tr><th>CL</th><td>{{ "%.2f"|format(best["CL"]) }}</td></tr>
<tr><th>alpha / pitch-trim defl</th><td>{{ "%.1f"|format(best["alpha_deg"]) }}° / {{ "%.1f"|format(best["deflection_deg"]) }}°</td></tr>
<tr><th>prop J vs peak-η J</th><td>{{ "%.2f"|format(best["J"]) }} / {{ "%.2f"|format(best["J_peak_eta"]) }}</td></tr>
<tr><th>η prop / motor / chain</th><td>{{ "%.2f"|format(best["eta_prop"]) }} / {{ "%.2f"|format(best["eta_motor"]) }} / {{ "%.2f"|format(best["eta_chain"]) }}</td></tr>
<tr><th>Wh/km (airspeed)</th><td>{{ "%.2f"|format(r.performance["wh_per_km_airspeed"]) }}</td></tr>
</table>
{% endif %}

{% for fig in figures %}
<img src="data:image/png;base64,{{ fig.b64 }}" alt="{{ fig.name }}">
{% endfor %}

{% if r.performance.get("optimization") %}
{% set opt = r.performance["optimization"] %}
<h2>Optimization</h2>
{# Which variables the champion is PINNED against, shown where the values are.
   The 2026-07-31 champion sat on eight declared bounds and the session
   discussed three, because reading them off meant comparing run.json against
   the aircraft file by hand (HANDOFF issue 0b). #}
{% set pinned = {} %}
{% for b in opt["champion"].get("active_bounds") or [] %}
{% set _ = pinned.update({b["variable"]: b}) %}
{% endfor %}
<table>
<tr><th>design variable</th><th>champion</th><th>declared box</th></tr>
{% set boxes = opt["champion"].get("dv_bounds") or {} %}
{% for k, v in opt["champion"]["dv"].items() %}<tr><td>{{ k }}</td><td>{{ "%.4f"|format(v) }}</td>
{% if pinned.get(k) %}
<td class="pinned">{{ "%.4g"|format(boxes.get(k, [None, None])[0] if boxes.get(k) else 0) }}
&hellip; {{ "%.4g"|format(boxes.get(k, [None, None])[1] if boxes.get(k) else 0) }}
— on its {{ pinned[k]["at"] }} bound</td>
{% elif boxes.get(k) and boxes[k][0] is not none and boxes[k][1] is not none %}
<td>{{ "%.4g"|format(boxes[k][0]) }} &hellip; {{ "%.4g"|format(boxes[k][1]) }}</td>
{% else %}<td>—</td>{% endif %}</tr>{% endfor %}
{# third cell on every row, including these three: the table gained a column and
   a short row leaves it ragged — the same defect the re-solve battery table
   carried for every run that had a failure #}
<tr><td>static margin (NLP)</td><td>{{ "%.3f"|format(opt["champion"].get("static_margin", 0)) }}</td><td>—</td></tr>
<tr><td>multistart spread</td><td>{{ "%.3f"|format(opt.get("multistart_objective_spread", 0)) }}</td><td>—</td></tr>
<tr><td>shadow price</td><td>{{ "%.4f"|format(opt.get("shadow_price_obj_per_gram", 0)) }} /g</td><td>—</td></tr>
</table>
{% if pinned %}
<p style="color:#9a9aa0;font-size:12px;">{{ pinned|length }} variable(s) sit on a
declared bound — the design asking for something it is not allowed to have. That
is a work list, not a defect: an active bound says nothing about its VALUE until
it is moved. <code>c_root</code> was pinned in every solve this project ever ran
and was worth 5 seconds when finally released — while being the difference
between three studies being answerable or not.</p>
{% endif %}
{% if opt.get("flatness_span") %}
{# The figure above plots only the spans that RETURNED a number, so a sweep
   whose bottom half holds no aircraft renders as a two-point line with no hint
   that four more spans were asked about. That is the more interesting half of
   the answer, and it was reachable only from run.json. #}
<h2>Flatness sweep (span fixed, everything else re-optimized)</h2>
<p style="color:#9a9aa0;font-size:12px;">Sampled around the CHAMPION's span
(down to {{ "%.0f"|format(100 * flatness_span_fraction) }}% of it, up to the
cap) rather than from a fixed 1.5 m — the question is how flat this optimum is,
which is a question about its neighbourhood. Flatness figures from runs before
2026-07-31 cover a different set of spans and are not comparable.</p>
<table>
<tr><th>span (m)</th><th>objective</th><th>minutes</th><th>outcome</th></tr>
{% for v in opt["flatness_span"] %}
<tr><td>{{ "%.2f"|format(v["span"]) }}</td>
{% if v.get("failed") %}
{# a SKIPPED span carries no minutes because it was never attempted, and "0.0"
   would read as a measured zero rather than as "not run" #}
<td class="bad">—</td>
<td>{% if v.get("solve_minutes") %}{{ "%.1f"|format(v["solve_minutes"]) }}{% else %}—{% endif %}</td>
<td class="bad">{{ v["failed"] }}</td>
{% else %}
<td>{{ "%.1f"|format(v["objective_value"]) }}</td>
<td>{{ "%.1f"|format(v.get("solve_minutes") or 0) }}</td>
<td>converged</td>
{% endif %}</tr>
{% endfor %}
</table>
<p style="color:#9a9aa0;font-size:12px;">Swept downward. A span
whose feasibility probe returns <code>Infeasible_Problem_Detected</code> holds no
aircraft, and since feasibility in span is an interval up to the cap, every
smaller span is then <code>Skipped_Below_Infeasible_Span</code> rather than
re-derived. A timeout proves nothing: the timed-out point is recorded as such,
and smaller points are explicitly marked unproven without repeating the same
member budget.</p>
{% endif %}
{% if opt.get("resolve_battery") %}
<h2>Re-solve battery (full re-optimizations)</h2>
<table>
<tr><th>case</th><th>objective</th><th>delta</th><th>span</th><th>SM</th><th>ballast g</th></tr>
{% for k, v in opt["resolve_battery"].items() %}
<tr><td>{{ k }}</td>
{# colspan 5, not 4: the header has six columns and a short failure row left the
   table ragged for every run that had one — which was every recent run. #}
{% if v.get("failed") %}<td colspan="5" class="bad">{{ v["failed"] }}</td>
{% else %}<td>{{ "%.1f"|format(v["objective_value"]) }}</td><td>{{ "%+.1f"|format(v["delta"]) }}</td>
<td>{{ "%.2f"|format(v["span"]) }}</td><td>{{ "%.3f"|format(v["static_margin"]) }}</td>
<td>{{ "%.0f"|format(v["ballast_kg"]*1000) }}</td>{% endif %}</tr>
{% endfor %}
</table>
{% endif %}
{% for attr, st in (opt.get("discrete_studies") or {}).items() if st.get("screen") %}
{# M5.3: what the no-NLP screen ranked, and therefore what the expensive stage
   never saw. A shortlist that is not shown is a shortlist nobody can argue
   with. #}
<h2>{{ attr }} screen — {{ st["screen"]["ranking"]|length }} candidates ranked without solving</h2>
<table>
<tr><th>#</th><th>candidate</th><th>screened</th><th>powertrain only</th><th>mass</th><th>re-solved?</th></tr>
{% for e in st["screen"]["ranking"][:12] %}
<tr><td>{{ loop.index }}</td><td>{{ e["candidate"] }}</td>
<td>{{ "%.1f"|format(e["screened_objective"]) }}</td>
<td>{{ "%.1f"|format(e["powertrain_only"]) }}</td>
<td>{{ "%+.0f"|format(e["mass_delta_g"]) }} g</td>
<td>{% if e["candidate"] in st["screen"]["shortlist"] %}<span class="ok">yes</span>{% else %}—{% endif %}</td></tr>
{% endfor %}
</table>
<p style="color:#9a9aa0;font-size:12px;">The airframe is held at the incumbent,
so the screen cannot see a candidate that would repay its mass by reshaping the
wing — it is a shortlister, and everything it returns is re-solved in full above.
Mass is charged at this run's own measured shadow price
({{ "%.4f"|format(st["screen"].get("shadow_price_obj_per_gram") or 0) }}/g);
without that a bigger disc arrives weightless.
{% if st["screen"].get("unreachable") %}{{ st["screen"]["unreachable"]|length }}
candidate(s) could not reach the operating point at all and are not ranked.{% endif %}</p>
{% endfor %}
{% if opt.get("winglet_study", {}).get("vlm_check") %}
{# The VLM second opinion, which until 2026-07-31 was not fit to print: it
   returned a negative k_induced — an inviscid wing making thrust — in every run
   since the first (FINDINGS §16.1). It is a CROSS-CHECK on the paired on/off
   re-optimizations above, never the verdict itself, and it now carries whether
   its own mesh ensemble agreed. #}
<h2>Winglet cross-check (inviscid VLM, independent of the lifting-line model)</h2>
<table>
<tr><th>configuration</th><th>k induced</th><th>e (projected span)</th><th>mesh ensemble</th></tr>
{% for cfg, v in opt["winglet_study"]["vlm_check"].items() %}
{% if v is mapping and "k_induced" in v %}
<tr><td>{{ cfg }}</td><td>{{ "%.5f"|format(v["k_induced"]) }}</td>
<td>{{ "%.3f"|format(v["e_projected_span"]) if v.get("e_projected_span") else "—" }}</td>
{% if v.get("reliable") %}<td class="ok">agreed ({{ v["meshes_in_consensus"]|length }} of {{ v["per_mesh"]|length }})</td>
{% else %}<td class="bad">not reliable — {{ v.get("unreliable_reason", "") }}</td>{% endif %}</tr>
{% endif %}
{% endfor %}
</table>
<p style="color:#9a9aa0;font-size:12px;">e is referenced to <b>projected</b> span,
so e&nbsp;&gt;&nbsp;1 is the nonplanar payoff rather than an error. A lower
<code>k</code> with the winglet on is the winglet earning its keep on induced
drag alone — the study's verdict above also charges its mass and profile drag.</p>
{% endif %}
{% if opt.get("tripped_polars") %}
<p><b>Tripped polars:</b> ΔCD {{ "%.4f"|format(opt["tripped_polars"]["dcd_total"]) }}
{% if opt["tripped_polars"]["objective_tripped"] %} → {{ "%.1f"|format(opt["tripped_polars"]["objective_tripped"]) }}
({{ "%+.1f"|format(opt["tripped_polars"]["delta"]) }}) if all laminar runs are lost{% endif %}</p>
{% endif %}
{% endif %}

{% if r.diagnostics.get("phase_minutes") %}
{# Where the run's hours went. A battery runs for hours and its phases fail
   independently, so "which phase cost what" is a first-class result — the
   2026-07-29 finding that 87% of a 405-minute run went to phases that failed
   had to be reconstructed by hand from the progress log. #}
<h2>Where the time went</h2>
{# A 0.0-minute phase is ambiguous on its own — not run, or fully resumed from
   an earlier run's checkpoints? The resumed column says which, because "this
   battery re-searched the design" is a claim the artifact should be able to
   support or withdraw. #}
{% set resumed = r.diagnostics.get("phase_resumed") or {} %}
<table>
<tr><th>phase</th><th>minutes</th><th>share</th>{% if resumed %}<th>resumed</th>{% endif %}</tr>
{% set total = r.diagnostics["phase_minutes"].values()|sum %}
{% for k, v in r.diagnostics["phase_minutes"].items()|sort(attribute='1', reverse=true) %}
<tr><td>{{ k }}</td><td>{{ "%.1f"|format(v) }}</td>
<td>{{ "%.0f"|format(100 * v / total if total else 0) }}%</td>
{% if resumed %}<td>{{ resumed.get(k, "—") }}</td>{% endif %}</tr>
{% endfor %}
<tr><th>total</th><th>{{ "%.1f"|format(total) }}</th><th></th>{% if resumed %}<th></th>{% endif %}</tr>
</table>
<p style="color:#9a9aa0;font-size:12px;">Per-solve wall-clock ceiling:
{{ r.diagnostics.get("solve_timeout_min", "—") }} min. A member that hits it is
recorded as <code>Maximum_WallTime_Exceeded</code> and the batch carries on.</p>
{% endif %}

{% set smc = r.diagnostics.get("sm_cross_check") %}
{% if smc and "static_margin" in smc %}
{# Cm is the quantity this project already knows is its weakest, and until
   2026-08-06 it was the only one nothing looked at twice while drag had two
   cross-checks. The comparable thing across methods is the SHAPE — whether the
   local slope changes sign — not the level, since this sweep is inviscid. #}
<h2>Static margin cross-check (independent method)</h2>
<table>
<tr><th></th><th>lifting line (in-loop)</th><th>VLM (inviscid)</th></tr>
<tr><td>static margin</td>
<td>{{ "%.4f"|format(smc["ll_static_margin"]) if smc.get("ll_static_margin") is not none else "—" }}</td>
<td>{{ "%.4f"|format(smc["static_margin"]) }}</td></tr>
<tr><td>slope sign constant across the window</td>
<td>{% if r.constraints.get("sm_sign_consistent") is sameas false %}<span class="bad">no</span>{% else %}<span class="ok">yes</span>{% endif %}</td>
<td>{% if smc["sign_consistent"] %}<span class="ok">yes</span>{% else %}<span class="bad">no</span>{% endif %}</td></tr>
<tr><td>mesh ensemble</td><td>—</td>
{% if smc.get("reliable") %}<td class="ok">{{ smc["meshes_in_consensus"]|length }} of {{ smc["per_mesh"]|length }} agreed</td>
{% else %}<td class="bad">not reliable — {{ smc.get("unreliable_reason", "") }}</td>{% endif %}</tr>
</table>
<p style="color:#9a9aa0;font-size:12px;">The two methods are sampled over the
<b>same</b> alpha window and run through the <b>same</b> estimator, so the only
difference between these numbers is the aerodynamics. They are not expected to
agree in LEVEL — this sweep is inviscid and carries no viscous Cm — so the row
that matters is the middle one. LL reporting a sign change that the VLM does not
see places the nonlinearity in LL's viscous Cm or its discretization, and is not
by itself a verdict on the aeroplane (FINDINGS §21).</p>
{% endif %}
{% set dir = r.diagnostics.get("directional_check") %}
{% if dir and "cn_beta" in dir %}
{# The verdict the declared vertical-tail-volume floor has always been a
   stand-in for, measured rather than assumed (MODEL_DETAILS 8.4, FINDINGS
   §21). Before 2026-08-06 no run ever checked whether the aeroplane that met
   the floor actually weathercocks. Guarded on the diagnostic itself and not on
   the optimization block, so the measurement cannot go missing because some
   unrelated key was empty. #}
<h2>Directional stability (inviscid VLM sideslip sweep)</h2>
<table>
<tr><th>derivative</th><th>per degree</th><th>stable when</th><th>verdict</th></tr>
<tr><td>Cn<sub>β</sub> — weathercock</td><td>{{ "%+.6f"|format(dir["cn_beta"]) }}</td><td>&gt; 0</td>
{% if dir["directionally_stable"] %}<td class="ok">stable</td>{% else %}<td class="bad">UNSTABLE</td>{% endif %}</tr>
<tr><td>Cl<sub>β</sub> — dihedral effect</td><td>{{ "%+.6f"|format(dir["cl_beta"]) }}</td><td>&lt; 0</td>
{% if dir["roll_stable"] %}<td class="ok">stable</td>{% else %}<td class="bad">UNSTABLE</td>{% endif %}</tr>
<tr><td>CY<sub>β</sub> — side force</td><td>{{ "%+.6f"|format(dir["cy_beta"]) }}</td><td>&lt; 0</td><td>—</td></tr>
<tr><td>mesh ensemble</td><td colspan="2">{{ dir["meshes_in_consensus"]|length }} of {{ dir["per_mesh"]|length }} agreed</td>
{% if dir.get("reliable") %}<td class="ok">agreed</td>
{% else %}<td class="bad">not reliable</td>{% endif %}</tr>
</table>
{% if not dir.get("reliable") %}
<p class="bad">{{ dir.get("unreliable_reason", "") }}</p>
{% endif %}
<p style="color:#9a9aa0;font-size:12px;">The in-loop constraint is a declared
vertical-tail-volume floor, not this — <code>Vv</code> is a proxy for
Cn<sub>β</sub> and the optimizer never sees the derivative itself. This is the
check that the proxy meant what it claimed. Measured at
α&nbsp;=&nbsp;{{ "%.1f"|format(dir["alpha_deg"]) }}° over sideslip
{{ dir["betas_deg"]|join(", ") }}°, and it is an <b>inviscid</b> sweep from the
same library as the in-loop model — a second opinion, not an independent one
(FINDINGS §21).</p>
{% endif %}
{% set ab = r.diagnostics.get("afterbody") %}
{% if ab %}
{# The fuselage drag model could not see afterbody SHAPE until 2026-08-05: any
   two bodies agreeing on wetted area, length, fineness and volume scored
   identically, so a 20-degree boat-tail was free and `pod_tail` sat on the
   geometric floor that stood in for the missing physics. This block is how a
   run says what that term charged it. #}
<h2>Afterbody (boat-tail separation and base pressure)</h2>
<table>
<tr><th>closure half-angle (max, d_eq convention)</th>
<td>{{ "%.1f"|format(ab["theta_max_deg"]) }}°
{% if ab["theta_max_deg"] > ab["theta_sep_deg"] %}<span class="pinned">separated</span>
{% else %}<span class="ok">attached</span>{% endif %}
— threshold {{ "%.0f"|format(ab["theta_sep_deg"]) }}°</td></tr>
<tr><th>separation station / effective base</th>
<td>u* = {{ "%.3f"|format(ab["u_star"]) }}, radius fraction {{ "%.3f"|format(ab["r_sep"]) }}
(end cap {{ "%.3f"|format(ab["r_cap"]) }}, occluded)</td></tr>
<tr><th>onset ramp λ</th><td>{{ "%.3f"|format(ab["lambda"]) }}</td></tr>
<tr><th>charged base area</th>
<td>{{ "%.4g"|format(ab["area_charged_m2"]) }} m² → drag area
{{ "%.4g"|format(ab["base_drag_area_m2"]) }} m²
{% if ab.get("share_of_body_drag") %}({{ "%.0f"|format(100 * ab["share_of_body_drag"]) }}% of body drag){% endif %}</td></tr>
<tr><th>fineness (L / d_eq)</th><td>{{ "%.2f"|format(ab["fineness"]) }}</td></tr>
</table>
<p style="color:#9a9aa0;font-size:12px;">One mechanism, not two: the station where
the local closure angle first crosses the threshold defines an enlarged effective
base, and unrecovered base pressure is charged there. The coefficient
(<code>CD_BASE</code>) is <b>declared and uncalibrated</b> — matched to AeroSandbox's
own low-Mach base-drag value so a future numeric cross-check compares like with
like, not fitted to anything this project has measured. Angles use the
d_eq-equivalent axisymmetric convention, so a 68 × 88 section's vertical-plane
closure is ~14% steeper in tangent than reported here.</p>
{% endif %}

{% set vmp = r.diagnostics.get("v_min_price") %}
{% set awp = r.diagnostics.get("airworthiness_price") %}
{% set dropped = r.diagnostics.get("sweep_dropped") or {} %}
{% set slopes = r.diagnostics.get("sm_local_slopes") or [] %}
{% set unstable = slopes|selectattr("sm_local", "lt", 0)|list %}
{% if vmp or awp or dropped.get("trim_not_converged") or r.constraints.get("sm_sign_consistent") is sameas false %}
{# What the headline number is limited BY, and what the sweep did NOT establish.
   Both were previously inferable only by reading run.json's sweep by hand. #}
<h2>What limits this result</h2>
{% if vmp %}
<p><strong>The minimum-speed requirement, not the airframe.</strong> The best
legal point is {{ "%.2f"|format(r.constraints["v_min_ms"]) }} m/s; the sweep's own
optimum is {{ "%.2f"|format(vmp["unconstrained_best_V_ms"]) }} m/s at
{{ "%.2f"|format(vmp["unconstrained_objective"]) }} {{ r.performance["objective_units"] }}
{% if vmp.get("cost_of_v_min") is not none %}—
<strong>{{ "%.2f"|format(vmp["cost_of_v_min"]) }} {{ r.performance["objective_units"] }}</strong>
that the requirement is currently costing{% endif %}. Relax the requirement, not
the aeroplane, to buy that back.</p>
{% endif %}
{% if awp %}
{# The same question asked of the filters that run BEFORE v_min is consulted.
   Without this the reported deflection, advance ratio and CL all read as
   comfortably inside their limits, because they belong to the one point the
   limits admitted. #}
<p><strong>An airworthiness filter, not the aeroplane's best point.</strong> The
sweep peaks at {{ "%.2f"|format(awp["unfiltered_objective"]) }}
{{ r.performance["objective_units"] }} at
{{ "%.2f"|format(awp["unfiltered_best_V_ms"]) }} m/s, and that point is excluded
by <code>{{ awp["peak_excluded_by"]|join(", ") }}</code>. What is reported above is
{{ "%.2f"|format(awp["reported_objective"]) }} {{ r.performance["objective_units"] }} —
<strong>{{ "%.2f"|format(awp["cost_of_airworthiness"]) }}
{{ r.performance["objective_units"] }}</strong> less.</p>
<table>
<thead><tr><th>filter</th><th>speeds it removed (m/s)</th><th>count</th></tr></thead>
<tbody>
{% for name, speeds in awp["excluded_by_rule"].items() %}
<tr><td><code>{{ name }}</code></td>
<td>{{ speeds|map("float")|map("round", 1)|join(", ") }}</td>
<td>{{ speeds|length }}</td></tr>
{% endfor %}
</tbody>
</table>
<p>Read the trim deflection, advance ratio and CL reported elsewhere in this
document as properties of the point that <em>survived</em> these filters, not as
evidence the design sits comfortably inside them.</p>
{% endif %}
{% if dropped.get("trim_not_converged") %}
<p><strong>Not proven infeasible:</strong> trim did not converge at
V = {{ dropped["trim_not_converged"]|map("float")|map("round", 1)|join(", ") }} m/s.
These points are absent from the sweep because there is no operating point to
report, <em>not</em> because none exists — the 2-D root-find ran out of progress
from every start it was given. Read them as unknown.</p>
{% endif %}
{% if r.constraints.get("sm_sign_consistent") is sameas false %}
{# Why `sm_sign_consistent` reads FAIL in the table below. It is a statement
   about the ESTIMATOR as much as the aeroplane, and a bare red FAIL invites
   the wrong one of those two readings. #}
<p><strong>The static margin changes sign inside its own window.</strong> The
reported {{ "%.4f"|format(r.constraints["static_margin"]) }} is a least-squares
slope over an alpha window about trim, not a derivative at trim — and the local
dCm/dCL goes negative at
{% for p in unstable %}{{ "%.2f"|format(p["alpha"]) }}°{% if not loop.last %}, {% endif %}{% endfor %},
so on this model the aircraft is not positively stable there. Cm(alpha)
nonlinearity is the known dominant fidelity limit of this estimator: read the
margin as an average over the window, and do not set the CG from it alone.</p>
{% endif %}
{% endif %}

<h2>Constraints</h2>
<table>
{% for k, v in r.constraints.items() %}
<tr><th>{{ k }}</th>
{# %.3f rounds a small residual to a flat "0.000", which is exactly the wrong
   thing to say about a gap between two nearly-equal numbers — switch to
   scientific notation below 0.01 so the magnitude survives. #}
<td>{% if v is sameas true %}<span class="ok">pass</span>{% elif v is sameas false %}<span class="bad">FAIL</span>{% elif v is number %}{% if v != 0 and (v|abs) < 0.01 %}{{ "%.2e"|format(v) }}{% else %}{{ "%.3f"|format(v) }}{% endif %}{% else %}{{ v }}{% endif %}</td></tr>
{% endfor %}
</table>

<h2>Geometry</h2>
<table>
{% for k, v in r.geometry.items() %}{% if v is not mapping %}<tr><th>{{ k }}</th><td>{% if v is integer %}{{ v }}{% elif v is number %}{{ "%.3f"|format(v) }}{% else %}{{ v }}{% endif %}</td></tr>{% endif %}{% endfor %}
</table>

{% if r.geometry.get("surfaces") %}
<h3>Surfaces</h3>
<table>
<tr><th>surface</th><th>airfoil</th><th>span (m)</th><th>area (m²)</th><th>root chord (mm)</th><th>tip chord (mm)</th></tr>
{% for name, s in r.geometry["surfaces"].items() %}
<tr><td>{{ name }}</td><td>{{ s.get("airfoil", "—") }}</td>
<td>{{ "%.3f"|format(s["span_m"]) }}</td><td>{{ "%.4f"|format(s["area_m2"]) }}</td>
<td>{{ "%.0f"|format(s["root_chord_m"]*1000) }}</td><td>{{ "%.0f"|format(s["tip_chord_m"]*1000) }}</td></tr>
{% endfor %}
</table>
{% endif %}

{% if stations %}
<h3>Build stations <span style="font-weight:400;color:#9a9aa0;font-size:12px;">— loft definition, metres, +x aft / +y starboard / +z up</span></h3>
<table>
<tr><th>surface</th><th>st</th><th>airfoil</th><th>chord (mm)</th><th>twist°</th>
<th>LE x</th><th>LE y</th><th>LE z</th><th>TE x</th></tr>
{% for s in stations %}
<tr><td>{{ s.surface }}</td><td>{{ s.station }}</td><td>{{ s.airfoil }}</td>
<td>{{ "%.1f"|format(s.chord_m*1000) }}</td><td>{{ "%.2f"|format(s.twist_deg) }}</td>
<td>{{ "%.4f"|format(s.x_le_m) }}</td><td>{{ "%.4f"|format(s.y_le_m) }}</td>
<td>{{ "%.4f"|format(s.z_le_m) }}</td><td>{{ "%.4f"|format(s.x_te_m) }}</td></tr>
{% endfor %}
</table>
<p style="color:#9a9aa0;font-size:12px;">Symmetric surfaces list the starboard half only — mirror about y&nbsp;=&nbsp;0.
Full 3D section outlines are in <code>geometry/sections_3d.csv</code>; see <code>geometry/README.txt</code>.</p>
<p><a href="manufacturing/BUILD.md">build document &#8599;</a> — spar stock and lengths, hinge lines,
leading/trailing-edge polylines, the CG window and the mass budget. This page says whether the design is
good; that one says what to cut and what to hit.</p>
{% endif %}

{% if r.geometry.get("winglet") %}
<h3>Winglet</h3>
<table>
{% for k, v in r.geometry["winglet"].items() %}<tr><th>{{ k }}</th><td>{% if v is integer %}{{ v }}{% elif v is number %}{{ "%.3f"|format(v) }}{% else %}{{ v }}{% endif %}</td></tr>{% endfor %}
</table>
{% endif %}

<h2>Masses</h2>
{% if r.masses.get("auw_kg") %}
<p><b>AUW {{ "%.0f"|format(r.masses["auw_kg"]*1000) }} g</b> · CG at {{ "%.1f"|format(r.masses["x_cg_m"]*1000) }} mm ·
wing loading {{ "%.1f"|format(r.masses["wing_loading_g_dm2"]) }} g/dm²</p>
{% endif %}
<div class="grid">
{% if r.masses.get("components") %}
<table>
<tr><th>component</th><th>g</th><th>station (mm)</th></tr>
{# artifacts written before 2026-08-05 carry a bare mass here, not a mapping #}
{% for k, v in r.masses["components"].items() %}<tr><td>{{ k }}</td><td>{{ "%.0f"|format((v["mass_kg"] if v is mapping else v)*1000) }}</td><td>{{ "%.0f"|format(v["station_mm"]) if v is mapping and v["station_mm"] is not none else "—" }}</td></tr>{% endfor %}
</table>
{% endif %}
{% for surf, bd in (r.masses.get("printed_breakdown") or {}).items() %}
<table>
<tr><th colspan="2">{{ surf }} terms{% if not bd.get("calibrated") %} <span class="bad">(uncalibrated)</span>{% endif %}</th></tr>
{% for k, v in bd.items() if k not in ("profile", "calibrated") %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}
</table>
{% endfor %}
</div>

{% if r.masses.get("fixed_totals") %}
<table>
{% for k, v in r.masses["fixed_totals"].items() %}<tr><th>{{ k }}</th><td>{{ "%.4f"|format(v) }}</td></tr>{% endfor %}
</table>
{% endif %}
{% if r.masses.get("fixed_equipment") %}
<table>
<tr><th>fixed equipment</th><th>kg</th></tr>
{% for k, v in r.masses["fixed_equipment"].items() %}<tr><td>{{ k }}</td><td>{{ "%.3f"|format(v) }}</td></tr>{% endfor %}
</table>
{% endif %}

{% set eq = r.masses.get("equipment") %}
{% if eq and not eq.get("failed") %}
<h2>Equipment placement</h2>
<p>{{ eq["totals_est"]["n_items"] }} airborne parts, fit <b>{{ eq["fit"] }}</b>, solved on the
<b>{{ eq["basis_solved"] }}</b> mass basis — {{ "%.0f"|format(eq["totals_est"]["total_kg"]*1000) }} g
with the example parts, {{ "%.0f"|format(eq["totals_max"]["total_kg"]*1000) }} g with every part at
its heaviest legal substitute.</p>
{% if eq.get("closure") %}
<p>Closure check at fixed placement: AUW
{{ "%.0f"|format(eq["closure"]["est"]["auw_kg"]*1000) }} g → {{ "%.0f"|format(eq["closure"]["max"]["auw_kg"]*1000) }} g,
CG {{ "%.1f"|format(eq["closure"]["est"]["x_cg_m"]*1000) }} mm → {{ "%.1f"|format(eq["closure"]["max"]["x_cg_m"]*1000) }} mm
(Δ {{ "%+.1f"|format(eq["closure"]["delta"]["x_cg_m"]*1000) }} mm). Not a re-optimization — same aeroplane, heavier parts.</p>
{% endif %}
<div class="scroll">
<table class="parts">
<tr><th>part</th><th class="num">station (mm)</th><th class="num">g</th><th class="num">max g</th>
<th>size (mm)</th><th>lane</th><th>requirement</th><th>not checked by this model</th></tr>
{% for row in eq["rows"] %}<tr>
<td>{{ row["item"] }}</td>
<td class="num">{{ row["station_mm"] }}</td>
<td class="num">{{ row["mass_g"] }}</td>
<td class="num">{{ row["max_g"] }}</td>
<td>{{ row["size_mm"] }}</td>
<td>{{ row["lane"] or row["status"] }}</td>
<td>{{ row["requirement"] }}</td>
<td class="caveat">{{ row["not checked here"] }}</td>
</tr>{% endfor %}
</table>
</div>
<p class="meta">The last column is the part of each requirement this model never
looked at — antenna geometry, cooling paths, hatch access, orientation. Those
stay the builder's.</p>

{% set pa = eq.get("placement_activity") %}
{% if pa and pa["n_placed"] %}
<h3>Did a free station per item buy anything?</h3>
<p>{{ pa["verdict"] }}. <b>Room</b> is how far a part could move with the others
held, so a part with none either way holds a number the packing rows already fix;
anything under {{ pa["tolerance_mm"] }} mm counts as none.</p>
<div class="scroll">
<table class="parts">
<tr><th>part</th><th class="num">station (mm)</th><th class="num">room fwd (mm)</th>
<th class="num">room aft (mm)</th><th>held by</th></tr>
{% for row in pa["items"] %}<tr>
<td>{{ row["item"] }}</td>
<td class="num">{{ "%.1f"|format(row["station_mm"]) }}</td>
<td class="num">{{ "%.1f"|format(row["room_fwd_mm"]) }}</td>
<td class="num">{{ "%.1f"|format(row["room_aft_mm"]) }}</td>
<td>{{ row["pinned_by"]|join(", ") or "nothing — free to move either way" }}</td>
</tr>{% endfor %}
</table>
</div>
<p class="meta">This is the measurement <code>EQUIPMENT_PLAN.md</code> attached to
the "free station per item" decision. It cannot come from <code>active_bounds</code>:
a placement variable's declared box is a wide numeric backstop, and its real
bounds are the symbolic lane rows.</p>
{% endif %}
{% endif %}

{% if r.notes %}
<h2>Notes</h2>
<ul>{% for n in r.notes %}<li>{{ n }}</li>{% endfor %}</ul>
{% endif %}
</body>
</html>
