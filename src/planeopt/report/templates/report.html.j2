<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>planeopt — {{ r.mission }} / {{ r.aircraft }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 62rem; padding: 0 1rem; }
  h1 { font-size: 1.4rem; } h2 { font-size: 1.1rem; margin-top: 2rem; }
  table { border-collapse: collapse; margin: .5rem 0; }
  td, th { border: 1px solid color-mix(in srgb, currentColor 25%, transparent); padding: .3rem .7rem; text-align: left; }
  .status { padding: .6rem 1rem; border-radius: .5rem; background: color-mix(in srgb, orange 18%, transparent); }
  .meta { opacity: .7; font-size: .85rem; }
  .ok { color: #2c8a2c; font-weight: 600; } .bad { color: #c33; font-weight: 600; }
  img { max-width: 100%; }
  .grid { display: flex; flex-wrap: wrap; gap: 1.5rem; }
</style>
</head>
<body>
<h1>planeopt run — {{ r.mission }} / {{ r.aircraft }}</h1>
<p class="meta">objective: <b>{{ r.objective }}</b>
({{ r.performance.get("objective_units", r.diagnostics.get("objective_units","")) }},
wind mode: {{ r.diagnostics.get("wind_mode","") }}) · created {{ r.created }}</p>
<p class="status">{{ r.status }}</p>
{% if has_3d %}<p><a href="interactive_3d.html">interactive 3D model &#8599;</a> (rotate/zoom in browser)</p>{% endif %}

{% if r.performance.get("best") %}
{% set best = r.performance["best"] %}
<h2>Best operating point</h2>
<table>
<tr><th>{{ r.objective }}</th><td><b>{{ "%.1f"|format(best.get("objective_value", 0)) }} {{ r.performance.get("objective_units","") }}</b></td></tr>
<tr><th>V</th><td>{{ "%.1f"|format(best["V_ms"]) }} m/s</td></tr>
<tr><th>P_elec</th><td>{{ "%.1f"|format(best["P_elec_w"]) }} W ({{ "%.1f"|format(r.performance["watts_per_kg"]) }} W/kg)</td></tr>
<tr><th>L/D (trimmed)</th><td>{{ "%.1f"|format(best["L_over_D"]) }}</td></tr>
<tr><th>CL</th><td>{{ "%.2f"|format(best["CL"]) }}</td></tr>
<tr><th>alpha / pitch-trim defl</th><td>{{ "%.1f"|format(best["alpha_deg"]) }}° / {{ "%.1f"|format(best["deflection_deg"]) }}°</td></tr>
<tr><th>prop J vs peak-η J</th><td>{{ "%.2f"|format(best["J"]) }} / {{ "%.2f"|format(best["J_peak_eta"]) }}</td></tr>
<tr><th>η prop / motor / chain</th><td>{{ "%.2f"|format(best["eta_prop"]) }} / {{ "%.2f"|format(best["eta_motor"]) }} / {{ "%.2f"|format(best["eta_chain"]) }}</td></tr>
<tr><th>Wh/km (airspeed)</th><td>{{ "%.2f"|format(r.performance["wh_per_km_airspeed"]) }}</td></tr>
</table>
{% endif %}

{% for fig in figures %}
<img src="data:image/png;base64,{{ fig.b64 }}" alt="{{ fig.name }}">
{% endfor %}

{% if r.performance.get("optimization") %}
{% set opt = r.performance["optimization"] %}
<h2>Optimization</h2>
<table>
<tr><th>design variable</th><th>champion</th></tr>
{% for k, v in opt["champion"]["dv"].items() %}<tr><td>{{ k }}</td><td>{{ "%.4f"|format(v) }}</td></tr>{% endfor %}
<tr><td>static margin (NLP)</td><td>{{ "%.3f"|format(opt["champion"].get("static_margin", 0)) }}</td></tr>
<tr><td>multistart spread</td><td>{{ "%.3f"|format(opt.get("multistart_objective_spread", 0)) }}</td></tr>
<tr><td>shadow price</td><td>{{ "%.4f"|format(opt.get("shadow_price_obj_per_gram", 0)) }} /g</td></tr>
</table>
{% if opt.get("resolve_battery") %}
<h2>Re-solve battery (full re-optimizations)</h2>
<table>
<tr><th>case</th><th>objective</th><th>delta</th><th>span</th><th>SM</th><th>ballast g</th></tr>
{% for k, v in opt["resolve_battery"].items() %}
<tr><td>{{ k }}</td>
{# colspan 5, not 4: the header has six columns and a short failure row left the
   table ragged for every run that had one — which was every recent run. #}
{% if v.get("failed") %}<td colspan="5" class="bad">{{ v["failed"] }}</td>
{% else %}<td>{{ "%.1f"|format(v["objective_value"]) }}</td><td>{{ "%+.1f"|format(v["delta"]) }}</td>
<td>{{ "%.2f"|format(v["span"]) }}</td><td>{{ "%.3f"|format(v["static_margin"]) }}</td>
<td>{{ "%.0f"|format(v["ballast_kg"]*1000) }}</td>{% endif %}</tr>
{% endfor %}
</table>
{% endif %}
{% if opt.get("tripped_polars") %}
<p><b>Tripped polars:</b> ΔCD {{ "%.4f"|format(opt["tripped_polars"]["dcd_total"]) }}
{% if opt["tripped_polars"]["objective_tripped"] %} → {{ "%.1f"|format(opt["tripped_polars"]["objective_tripped"]) }}
({{ "%+.1f"|format(opt["tripped_polars"]["delta"]) }}) if all laminar runs are lost{% endif %}</p>
{% endif %}
{% endif %}

{% if r.diagnostics.get("phase_minutes") %}
{# Where the run's hours went. A battery runs for hours and its phases fail
   independently, so "which phase cost what" is a first-class result — the
   2026-07-29 finding that 87% of a 405-minute run went to phases that failed
   had to be reconstructed by hand from the progress log. #}
<h2>Where the time went</h2>
<table>
<tr><th>phase</th><th>minutes</th><th>share</th></tr>
{% set total = r.diagnostics["phase_minutes"].values()|sum %}
{% for k, v in r.diagnostics["phase_minutes"].items()|sort(attribute='1', reverse=true) %}
<tr><td>{{ k }}</td><td>{{ "%.1f"|format(v) }}</td>
<td>{{ "%.0f"|format(100 * v / total if total else 0) }}%</td></tr>
{% endfor %}
<tr><th>total</th><th>{{ "%.1f"|format(total) }}</th><th></th></tr>
</table>
<p style="color:#9a9aa0;font-size:12px;">Per-solve wall-clock ceiling:
{{ r.diagnostics.get("solve_timeout_min", "—") }} min. A member that hits it is
recorded as <code>Maximum_WallTime_Exceeded</code> and the batch carries on.</p>
{% endif %}

<h2>Constraints</h2>
<table>
{% for k, v in r.constraints.items() %}
<tr><th>{{ k }}</th>
{# %.3f rounds a small residual to a flat "0.000", which is exactly the wrong
   thing to say about a gap between two nearly-equal numbers — switch to
   scientific notation below 0.01 so the magnitude survives. #}
<td>{% if v is sameas true %}<span class="ok">pass</span>{% elif v is sameas false %}<span class="bad">FAIL</span>{% elif v is number %}{% if v != 0 and (v|abs) < 0.01 %}{{ "%.2e"|format(v) }}{% else %}{{ "%.3f"|format(v) }}{% endif %}{% else %}{{ v }}{% endif %}</td></tr>
{% endfor %}
</table>

<h2>Geometry</h2>
<table>
{% for k, v in r.geometry.items() %}{% if v is not mapping %}<tr><th>{{ k }}</th><td>{% if v is integer %}{{ v }}{% elif v is number %}{{ "%.3f"|format(v) }}{% else %}{{ v }}{% endif %}</td></tr>{% endif %}{% endfor %}
</table>

{% if r.geometry.get("surfaces") %}
<h3>Surfaces</h3>
<table>
<tr><th>surface</th><th>airfoil</th><th>span (m)</th><th>area (m²)</th><th>root chord (mm)</th><th>tip chord (mm)</th></tr>
{% for name, s in r.geometry["surfaces"].items() %}
<tr><td>{{ name }}</td><td>{{ s.get("airfoil", "—") }}</td>
<td>{{ "%.3f"|format(s["span_m"]) }}</td><td>{{ "%.4f"|format(s["area_m2"]) }}</td>
<td>{{ "%.0f"|format(s["root_chord_m"]*1000) }}</td><td>{{ "%.0f"|format(s["tip_chord_m"]*1000) }}</td></tr>
{% endfor %}
</table>
{% endif %}

{% if stations %}
<h3>Build stations <span style="font-weight:400;color:#9a9aa0;font-size:12px;">— loft definition, metres, +x aft / +y starboard / +z up</span></h3>
<table>
<tr><th>surface</th><th>st</th><th>airfoil</th><th>chord (mm)</th><th>twist°</th>
<th>LE x</th><th>LE y</th><th>LE z</th><th>TE x</th></tr>
{% for s in stations %}
<tr><td>{{ s.surface }}</td><td>{{ s.station }}</td><td>{{ s.airfoil }}</td>
<td>{{ "%.1f"|format(s.chord_m*1000) }}</td><td>{{ "%.2f"|format(s.twist_deg) }}</td>
<td>{{ "%.4f"|format(s.x_le_m) }}</td><td>{{ "%.4f"|format(s.y_le_m) }}</td>
<td>{{ "%.4f"|format(s.z_le_m) }}</td><td>{{ "%.4f"|format(s.x_te_m) }}</td></tr>
{% endfor %}
</table>
<p style="color:#9a9aa0;font-size:12px;">Symmetric surfaces list the starboard half only — mirror about y&nbsp;=&nbsp;0.
Full 3D section outlines are in <code>geometry/sections_3d.csv</code>; see <code>geometry/README.txt</code>.</p>
<p><a href="manufacturing/BUILD.md">build document &#8599;</a> — spar stock and lengths, hinge lines,
leading/trailing-edge polylines, the CG window and the mass budget. This page says whether the design is
good; that one says what to cut and what to hit.</p>
{% endif %}

{% if r.geometry.get("winglet") %}
<h3>Winglet</h3>
<table>
{% for k, v in r.geometry["winglet"].items() %}<tr><th>{{ k }}</th><td>{% if v is integer %}{{ v }}{% elif v is number %}{{ "%.3f"|format(v) }}{% else %}{{ v }}{% endif %}</td></tr>{% endfor %}
</table>
{% endif %}

<h2>Masses</h2>
{% if r.masses.get("auw_kg") %}
<p><b>AUW {{ "%.0f"|format(r.masses["auw_kg"]*1000) }} g</b> · CG at {{ "%.1f"|format(r.masses["x_cg_m"]*1000) }} mm ·
wing loading {{ "%.1f"|format(r.masses["wing_loading_g_dm2"]) }} g/dm²</p>
{% endif %}
<div class="grid">
{% if r.masses.get("components") %}
<table>
<tr><th>component</th><th>g</th></tr>
{% for k, v in r.masses["components"].items() %}<tr><td>{{ k }}</td><td>{{ "%.0f"|format(v*1000) }}</td></tr>{% endfor %}
</table>
{% endif %}
{% for surf, bd in (r.masses.get("printed_breakdown") or {}).items() %}
<table>
<tr><th colspan="2">{{ surf }} terms{% if not bd.get("calibrated") %} <span class="bad">(uncalibrated)</span>{% endif %}</th></tr>
{% for k, v in bd.items() if k not in ("profile", "calibrated") %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}
</table>
{% endfor %}
</div>

{% if r.masses.get("fixed_totals") %}
<table>
{% for k, v in r.masses["fixed_totals"].items() %}<tr><th>{{ k }}</th><td>{{ "%.4f"|format(v) }}</td></tr>{% endfor %}
</table>
{% endif %}
{% if r.masses.get("fixed_equipment") %}
<table>
<tr><th>fixed equipment</th><th>kg</th></tr>
{% for k, v in r.masses["fixed_equipment"].items() %}<tr><td>{{ k }}</td><td>{{ "%.3f"|format(v) }}</td></tr>{% endfor %}
</table>
{% endif %}

{% if r.notes %}
<h2>Notes</h2>
<ul>{% for n in r.notes %}<li>{{ n }}</li>{% endfor %}</ul>
{% endif %}
</body>
</html>
